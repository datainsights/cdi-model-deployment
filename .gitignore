# Repository-specific Python environment
.venv/
venv/
env/
.python-version
.env
.env.*
!.env.example

# Python caches and test output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Quarto intermediates and local caches
/.quarto/
/_freeze/
/.cache/
/.jupyter_cache/
**/*.quarto_ipynb

# Rendered HTML outside the published docs directory
/*.html
/*_files/

# Generated deployment artifacts
data/raw/*
data/processed/*
data/reference/*
data/inference/*
models/*
results/figures/*
results/metrics/*
results/monitoring/*
reports/*
results/predictions/

# Preserve directory documentation
!data/**/README.md
!models/README.md
!results/**/README.md
!reports/README.md

# Local Docker configuration
docker-compose.override.yml

# Packaged releases and archives
*.zip
*.tar.gz

# Local and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.log
